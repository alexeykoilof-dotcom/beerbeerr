[sub_resource type="Shader" id="Shader_blur"]
code = "shader_type canvas_item;\nuniform sampler2D screen_texture : hint_screen_texture, filter_linear_mipmap;\nuniform float blur_strength = 2.4;\nvoid fragment() {\n\tvec4 blurred = textureLod(screen_texture, SCREEN_UV, blur_strength);\n\tCOLOR = vec4(blurred.rgb, 0.94);\n}"

[sub_resource type="ShaderMaterial" id="Material_blur"]
